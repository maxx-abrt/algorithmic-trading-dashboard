# ═════════════════════════════════════════════════════════════════════════════
#  APEX-02 / MYCROFT — environment template
#  cp .env.example engine/.env        (engine secrets)
#  cp .env.example frontend/.env.local (only the NEXT_PUBLIC_* + CONVEX_DEPLOY_KEY)
# ═════════════════════════════════════════════════════════════════════════════

# ── Convex (required) ────────────────────────────────────────────────────────
# `npx convex dev` prints these on first run.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_URL=https://<your-deployment>.convex.cloud
# Convex Dashboard -> Settings -> Deploy keys (needed only to push functions)
CONVEX_DEPLOY_KEY=
# Shared secret guarding every engine -> Convex write.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   npx convex env set WORKER_API_KEY <same value>
WORKER_API_KEY=

# ── Engine ───────────────────────────────────────────────────────────────────
PORT=8790
DEFAULT_EQUITY_USD=10000

# ── Google Gemini (AI arbitration, optional but recommended) ─────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Telegram companion (optional) ────────────────────────────────────────────
# Create a bot with @BotFather, then send it /start and the engine registers you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OKX (optional — public market data requires NO keys) ─────────────────────
# Read-only keys unlock balance-aware sizing. The engine NEVER places orders.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED=false
