# ─────────────────────────────────────────────────────────────────────────────
# APEX-01 — copy this file to .env.local and fill it in.
#   cp .env.example .env.local
# Both the Next.js dashboard and the worker read .env.local.
# NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Convex (required) ─────────────────────────────────────────────────────
# Your deployment URL. `npx convex dev` writes this for you on first run.
NEXT_PUBLIC_CONVEX_URL=https://energetic-cod-476.eu-west-1.convex.cloud

# ── 2. Worker shared secret (required) ───────────────────────────────────────
# Any long random string. Guards every Convex mutation so only your worker and
# your server actions can write. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must ALSO be set inside Convex:
#   npx convex env set WORKER_API_KEY <same-value>
WORKER_API_KEY=

# ── 3. Gemini (optional — bot runs on pure quant signals without it) ─────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 4. OKX (optional — leave empty to stay in paper mode) ────────────────────
# Create keys at https://www.okx.com/account/my-api  (permission: Trade)
# For risk-free testing use OKX Demo Trading keys and set OKX_SIMULATED=true.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED=true

# ── 5. Tuning (optional) ─────────────────────────────────────────────────────
PAPER_EQUITY_USD=10000
AI_COOLDOWN_MS=90000
EVAL_THROTTLE_MS=3000
